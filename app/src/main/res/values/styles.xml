<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="QuizOptionButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_option_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_option_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:focusable">true</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="RowButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_option_button</item>
        <item name="android:textColor">#ECEFF1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:focusable">true</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="IntervalRadio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:buttonTint">@color/accent_gold</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
