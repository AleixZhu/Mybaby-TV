<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_quiz_panel"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="答题时间到"
            android:textColor="#FFD54F"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="需连续答对 1 题"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_stem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:minHeight="72dp"
            android:text="题干"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="剩余 60 秒"
            android:textColor="#FF8A65"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_opt_0"
                style="@style/QuizOptionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:nextFocusRight="@id/btn_opt_1"
                android:text="A" />

            <Button
                android:id="@+id/btn_opt_1"
                style="@style/QuizOptionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:nextFocusLeft="@id/btn_opt_0"
                android:nextFocusRight="@id/btn_opt_2"
                android:text="B" />

            <Button
                android:id="@+id/btn_opt_2"
                style="@style/QuizOptionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:nextFocusLeft="@id/btn_opt_1"
                android:nextFocusRight="@id/btn_opt_3"
                android:text="C" />

            <Button
                android:id="@+id/btn_opt_3"
                style="@style/QuizOptionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:nextFocusLeft="@id/btn_opt_2"
                android:text="D" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:minHeight="24dp"
            android:text=""
            android:textColor="#81C784"
            android:textSize="16sp" />

        <!-- 管理员解锁入口：任何时刻都可以点 -->
        <Button
            android:id="@+id/btn_admin_unlock"
            style="@style/RowButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:minWidth="200dp"
            android:text="管理员解锁"
            android:textSize="14sp" />

        <!-- 密码输入面板：点了「管理员解锁」后展开 -->
        <LinearLayout
            android:id="@+id/lock_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_lock_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="请输入家长密码解锁"
                android:textColor="#EF9A9A"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_password_field"
                    android:hint="家长密码"
                    android:inputType="numberPassword"
                    android:maxLength="16"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#78909C"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_unlock"
                    style="@style/QuizOptionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minWidth="100dp"
                    android:text="确认解锁" />

                <Button
                    android:id="@+id/btn_unlock_cancel"
                    style="@style/RowButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="100dp"
                    android:text="返回答题" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
