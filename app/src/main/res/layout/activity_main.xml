<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1720"
    android:fillViewport="true"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFD54F"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="每看一段时间就弹题，答对才能继续看"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <!-- 当前状态卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_quiz_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="守护状态：--"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_interval_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="间隔：--"
                android:textColor="#CFD8DC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_pending_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="断电续弹：--"
                android:textColor="#CFD8DC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_bank_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="题库：--"
                android:textColor="#CFD8DC"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 权限检查卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="必要权限"
                android:textColor="#FFD54F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_perm_overlay"
                style="@style/RowButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="1. 悬浮窗权限（弹题必需）" />

            <Button
                android:id="@+id/btn_perm_usage"
                style="@style/RowButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2. 使用情况访问（识别视频 APP 前台）" />

            <Button
                android:id="@+id/btn_perm_notification"
                style="@style/RowButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="3. 通知权限（Android 13+）" />
        </LinearLayout>

        <!-- 操作区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启动守护" />

            <Button
                android:id="@+id/btn_stop"
                style="@style/RowButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="停止" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_settings"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置（需密码）" />

            <Button
                android:id="@+id/btn_test_popup"
                style="@style/RowButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="立即试弹一次" />
        </LinearLayout>

        <!-- 关闭 APP 但保留守护进程：孩子/家长按遥控器返回时可以真正退回桌面去看电视 -->
        <Button
            android:id="@+id/btn_exit_app"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="退出应用（守护继续运行）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="说明：HDMI 信号属于硬件视频层，Android 应用无法在其上叠加窗口；本 APP 只能在其它视频类 APP（爱奇艺/腾讯/优酷/B站/YouTube 等）前台时弹题。孩子从 HDMI 切回 Android 界面时会立即补弹。"
            android:textColor="#78909C"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
